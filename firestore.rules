rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.keys().hasAny(['isPro', 'stripeCustomerId', 'stripeSubscriptionId']) 
                        || request.resource.data.isPro == false);
      allow update: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPro', 'stripeCustomerId', 'stripeSubscriptionId']));
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      // Subcollections: progress, collections, annotations
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}